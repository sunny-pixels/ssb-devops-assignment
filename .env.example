# Copy to .env and fill in real values:  cp .env.example .env && chmod 640 .env
# .env is git-ignored. NEVER commit real credentials.

# --- Database (used by the PHP app and the scripts) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ssb_inventory
DB_USER=ssb_app
DB_PASS=change_me

# --- Paths (used by deploy.sh / backup.sh) ---
LAMPP_HOME=/opt/lampp
SOURCE_DIR=/home/ssbadmin/ssb-devops-assignment/app
DEPLOY_DIR=/opt/lampp/htdocs/ssb-app
BACKUP_DIR=/home/ssbadmin/backups
BACKUP_RETENTION_DAYS=7

# --- Health check ---
APP_URL=http://localhost/ssb-app
